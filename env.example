# Connection string PostgreSQL (kami memakai Neon). Pakai koneksi langsung, bukan pooled.
DATABASE_URL=

# Penyedia AI: google atau groq
AI_PROVIDER=groq

# Nama model persis seperti di dashboard penyedia. Nama model sering berganti, jadi cek dulu.
AI_MODEL=

GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Tampilkan panel Mode demo di production. Saat development panel selalu tampil.
# DEMO_MODE=1
