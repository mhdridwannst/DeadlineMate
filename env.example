# Salin file ini ke .env untuk development. Isi nilai dari provider masing-masing.
# PostgreSQL (Neon): gunakan connection string yang sesuai untuk aplikasi.
DATABASE_URL=

AUTH_SECRET=
# Set true untuk deployment di balik reverse proxy tepercaya seperti Vercel.
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Groq: nama model harus tersedia pada akun/provider yang digunakan.
GROQ_API_KEY=
AI_MODEL=

# URL publik aplikasi, tanpa slash di akhir. Ganti dengan domain Vercel di production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# Reset password lewat Resend. Production perlu sender dari domain yang diverifikasi.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Upload lampiran lewat Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Wajib di production untuk endpoint pengingat cron
CRON_SECRET=

# Aktifkan hanya jika memang ingin menyediakan mode demo di production.
# DEMO_MODE=1
