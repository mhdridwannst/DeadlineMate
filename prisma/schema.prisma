generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum CoachTone {
  SANTAI
  TEGAS
  SUPPORTIVE
}

// ============ MODEL AUTH.JS ============

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // <-- Buat Credentials login

  // Relasi Auth.js
  accounts      Account[]
  sessions      Session[]

  // Relasi App DeadlineMate
  coachTone     CoachTone @default(SUPPORTIVE)
  score         Int       @default(0)
  createdAt     DateTime  @default(now())
  tasks         Task[]
  attendance    Attendance[]
  notes         CoachNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ MODEL APP DEADLINEMATE ============

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  title       String
  notes       String?
  category    String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  softDueAt   DateTime?
  estimateMin Int?
  postponed   Int        @default(0)
  doneAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, status, dueAt])
}

model Attendance {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  @@unique([userId, date])
}

model CoachNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  body      String
  createdAt DateTime @default(now())
}