generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum CoachTone {
  SANTAI
  TEGAS
  SUPPORTIVE
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  password   String?
  coachTone  CoachTone @default(SUPPORTIVE)
  score      Int       @default(0)
  createdAt  DateTime  @default(now())
  tasks      Task[]
  attendance Attendance[]
  notes      CoachNote[]
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")
  title       String
  notes       String?
  category    String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  softDueAt   DateTime?
  estimateMin Int?
  postponed   Int        @default(0)
  doneAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, status, dueAt])
}


model Attendance {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  @@unique([userId, date])
}

model CoachNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  body      String
  createdAt DateTime @default(now())
}